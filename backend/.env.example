NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
SESSION_TTL_MINUTES=60
# Leave blank only for local development: a random, in-memory secret is generated
# and sessions end when the backend restarts. Production requires a 32+ character
# non-placeholder value.
AUTH_TOKEN_SECRET=
DATABASE_PATH=./data/daemondeck.sqlite
# Explicit local-only demo mode. It requires NODE_ENV=development or test.
DEMO_MODE=true
# Set DEMO_MODE=false and provide these values to create a first administrator
# for a new non-demo database. Password must be 16+ characters and no more
# than 72 UTF-8 bytes (bcrypt's effective input limit).
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
ENABLE_PROCESS_KILL=false
TRUST_PROXY=false
