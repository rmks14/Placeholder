# Required. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
AUTH_TOKEN_SECRET=
CLIENT_URL=http://localhost:8080
FRONTEND_PORT=8080
SESSION_TTL_MINUTES=60

# Required only for the first start with an empty database. Password must be at
# least 16 characters and no more than 72 UTF-8 bytes. Do not commit a completed
# .env.docker file.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
